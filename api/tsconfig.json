{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "com": ["../com/index.js"]
    }
  },
  "include": ["modules/**/*.ts"]
}
