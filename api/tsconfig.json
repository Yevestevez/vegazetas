{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "com": ["../com/index.ts"],
      "com/*": ["../com/*"]
    }
  },
  "include": ["modules/**/*.ts", "data/**/*.ts", "util/**/*.ts", "middlewares/**/*.ts", "config/**/*.ts", "routes/**/*.ts", "app.ts", "index.ts"]
}
